# Runtime
NODE_ENV=development
APP_PORT=4000
FRONTEND_PORT=5173
WORKER_PORT=4010

# Local PostgreSQL
DATABASE_URL=postgresql://secretary:secretary@localhost:5432/aidasecretary?schema=public

# Auth
SESSION_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_TTL_HOURS=8

# Storage
LOCAL_AUDIO_STORAGE_PATH=./storage/audio
LOCAL_DATA_STORAGE_PATH=./storage/local-data
MAX_UPLOAD_MB=50

# AI/ASR providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
ASR_MODEL=whisper-1